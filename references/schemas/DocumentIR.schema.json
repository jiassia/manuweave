{
  "$defs": {
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "title",
            "author",
            "author_zh",
            "author_en",
            "affiliation",
            "affiliation_zh",
            "affiliation_en",
            "subtitle",
            "subtitle_zh",
            "subtitle_en",
            "correspondence",
            "correspondence_zh",
            "correspondence_en",
            "body_start",
            "title_zh",
            "title_en",
            "abstract_zh",
            "abstract_en",
            "keywords_zh",
            "keywords_en",
            "figure_caption_zh",
            "figure_caption_en",
            "table_caption_zh",
            "table_caption_en",
            "heading1",
            "heading2",
            "heading3",
            "heading4",
            "heading5",
            "heading6",
            "body",
            "abstract_heading",
            "abstract",
            "keywords",
            "references_heading",
            "reference",
            "caption",
            "figure_caption",
            "table_caption",
            "equation",
            "table",
            "table_body",
            "image",
            "legacy_image",
            "toc",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceMap"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        }
      },
      "required": [
        "id",
        "source"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "SourceMap": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        }
      },
      "required": [
        "file",
        "locator"
      ],
      "title": "SourceMap",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "kind": {
      "enum": [
        "docx",
        "latex"
      ],
      "title": "Kind",
      "type": "string"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/ContentBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "inventory": {
      "additionalProperties": true,
      "title": "Inventory",
      "type": "object"
    }
  },
  "required": [
    "source",
    "kind",
    "blocks",
    "inventory"
  ],
  "title": "DocumentIR",
  "type": "object"
}
